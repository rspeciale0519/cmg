--- /dev/null
+++ b/src/lib/cmg-bridge/admission.ts
@@ -0,0 +1,16 @@
+import type {DbPool} from '../db/connection.ts';
+/** One active bridge operation per installation; contenders release immediately.
+ * A blocking session lock in the shared pool would starve its own holder.
+ */
+export async function acquireBridgeAdmission(database:DbPool,firmId:string){
+ const connection=await database.connect();let held=false;
+ const key=firmId+':cmg-bridge-admission-v1';
+ try{
+  held=(await connection.query<{acquired:boolean}>('select pg_try_advisory_lock(hashtextextended($1,0)) as acquired',[key])).rows[0]?.acquired===true;
+  if(!held){connection.release();return null;}
+ }catch(error){connection.release(true);throw error;}
+ return {release:async()=>{
+  try{await connection.query('select pg_advisory_unlock(hashtextextended($1,0))',[key]);connection.release();}
+  catch(error){connection.release(true);throw error;}
+ }};
+}
