index 0000000..1e7a5f1
--- /dev/null
+++ b/db/migrations/20261117010100_cmg_bridge_review_lock.sql
@@ -0,0 +1,47 @@
+-- A reviewed CMG draft may not be edited or sent from an ordinary sender
+-- session. Actual signing may still update values/status after guarded send.
+create function cmg_guard_reviewed_parties() returns trigger
+language plpgsql security invoker set search_path=public as $fn$
+declare target text;
+begin
+  target := case when tg_op='DELETE' then old.envelope_id else new.envelope_id end;
+  if exists(select 1 from cmg_bridge_envelopes b join envelopes e on e.id=b.envelope_id
+    where e.id in (target,case when tg_op='UPDATE' then old.envelope_id else target end)
+      and b.prepared and e.status='draft') then
+    raise exception 'CMG-reviewed draft is locked; prepare a new review in CMG' using errcode='23514';
+  end if;
+  if tg_table_name='signers' and tg_op='UPDATE' then
+    if (new.name,new.email,new.sign_order,new.role,new.envelope_id) is distinct from
+         (old.name,old.email,old.sign_order,old.role,old.envelope_id)
+     and exists(select 1 from cmg_bridge_envelopes b where b.envelope_id in (old.envelope_id,new.envelope_id) and b.prepared) then
+      raise exception 'CMG recipient corrections require a new reviewed request' using errcode='23514';
+    end if;
+  end if;
+  return case when tg_op='DELETE' then old else new end;
+end;
+$fn$;
+create trigger cmg_reviewed_fields_guard before insert or update or delete on fields
+for each row execute function cmg_guard_reviewed_parties();
+create trigger cmg_reviewed_signers_guard before insert or update or delete on signers
+for each row execute function cmg_guard_reviewed_parties();
+
+create function cmg_guard_reviewed_envelope() returns trigger
+language plpgsql security invoker set search_path=public as $fn$
+declare binding cmg_bridge_envelopes%rowtype;
+begin
+  select * into binding from cmg_bridge_envelopes where envelope_id=old.id;
+  if not found then return new; end if;
+  if old.status='draft' and new.status='sent' and not binding.send_started then
+    raise exception 'CMG send ownership is required' using errcode='23514';
+  end if;
+  if binding.prepared and
+     (new.user_id,new.title,new.source_pdf_key,new.source_pdf_hash,new.source_pdf_size_bytes,new.page_count) is distinct from
+     (old.user_id,old.title,old.source_pdf_key,old.source_pdf_hash,old.source_pdf_size_bytes,old.page_count) then
+    raise exception 'CMG-reviewed source is immutable' using errcode='23514';
+  end if;
+  return new;
+end;
+$fn$;
+create trigger cmg_reviewed_envelope_guard before update on envelopes
+for each row execute function cmg_guard_reviewed_envelope();
+revoke all on function cmg_guard_reviewed_parties(),cmg_guard_reviewed_envelope() from public;
