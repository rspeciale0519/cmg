@@ -0,0 +1,21 @@
+-- Historical send intent is not a capability. Only the bridge's own send
+-- transaction sets this local value; pooled connections cannot retain it.
+create or replace function cmg_guard_reviewed_envelope() returns trigger
+language plpgsql security invoker set search_path=public as $fn$
+declare binding cmg_bridge_envelopes%rowtype;
+begin
+  select * into binding from cmg_bridge_envelopes where envelope_id=old.id;
+  if not found then return new; end if;
+  if old.status='draft' and new.status='sent' and
+     (not binding.send_started or current_setting('cmg.bridge_attempt',true) is distinct from binding.attempt_token::text) then
+    raise exception 'CMG send ownership is required' using errcode='23514';
+  end if;
+  if binding.prepared and
+     (new.user_id,new.title,new.source_pdf_key,new.source_pdf_hash,new.source_pdf_size_bytes,new.page_count) is distinct from
+     (old.user_id,old.title,old.source_pdf_key,old.source_pdf_hash,old.source_pdf_size_bytes,old.page_count) then
+    raise exception 'CMG-reviewed source is immutable' using errcode='23514';
+  end if;
+  return new;
+end;
+$fn$;
+revoke all on function cmg_guard_reviewed_envelope() from public;
