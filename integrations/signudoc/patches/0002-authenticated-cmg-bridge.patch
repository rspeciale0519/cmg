+import assert from 'node:assert/strict';
+import test from 'node:test';
+import {bridgeRequestSchema} from './request.ts';
+const ids={claimId:'11111111-1111-4111-8111-111111111111',attemptToken:'22222222-2222-4222-8222-222222222222'};
+test('read operations require exact claim/attempt binding and reject caller-chosen owner or arbitrary URLs',()=>{
+ assert.equal(bridgeRequestSchema.safeParse({action:'status',...ids}).success,true);
+ for(const value of [{action:'status',claimId:ids.claimId},{action:'status',...ids,userId:'other-owner'},{action:'download',...ids,artifact:'https://evil.invalid/file'},{action:'send',...ids,permittedUseConfirmed:false}])assert.equal(bridgeRequestSchema.safeParse(value).success,false);
+});
+test('unknown operations, malformed identities and oversized documents are refused',()=>{
+ for(const value of [{action:'delete',...ids},{action:'status',...ids,claimId:'not-id'},{action:'prepare',...ids,title:'test',pdfBase64:'A'.repeat(4000001),sourceSha256:'a'.repeat(64),signers:[],fields:[]}])assert.equal(bridgeRequestSchema.safeParse(value).success,false);
+});
diff --git a/src/lib/cmg-bridge/request.ts b/src/lib/cmg-bridge/request.ts
new file mode 100644
index 0000000..724d4db
--- /dev/null
+++ b/src/lib/cmg-bridge/request.ts
@@ -0,0 +1,17 @@
+import {z} from 'zod';
+const binding={claimId:z.uuid(),attemptToken:z.uuid()};
+const role=z.enum(['Homeowner1','Homeowner2']);
+const signer=z.object({role,name:z.string().trim().min(1).max(160),email:z.email().max(320)}).strict();
+const field=z.object({role,type:z.enum(['signature','initials','date']),page:z.number().int().min(1).max(9),x:z.number().min(0).max(1),y:z.number().min(0).max(1),width:z.number().positive().max(1),height:z.number().positive().max(1),required:z.boolean(),label:z.string().min(1).max(120)}).strict();
+const prepare=z.object({action:z.literal('prepare'),...binding,title:z.string().trim().min(1).max(200),pdfBase64:z.string().min(8).max(3200000).regex(/^[A-Za-z0-9+/]+={0,2}$/),sourceSha256:z.string().regex(/^[a-f0-9]{64}$/),signers:z.array(signer).min(1).max(2),fields:z.array(field).min(1).max(50)}).strict().superRefine((v,ctx)=>{
+ if(v.signers[0]?.role!=='Homeowner1'||(v.signers.length===2&&v.signers[1]?.role!=='Homeowner2')||new Set(v.signers.map(s=>s.email.toLowerCase())).size!==v.signers.length)ctx.addIssue({code:'custom',message:'Distinct ordered signers required'});
+ if(v.fields.some(f=>!v.signers.some(s=>s.role===f.role)||f.x+f.width>1.000001||f.y+f.height>1.000001)||new Set(v.fields.map(f=>f.label)).size!==v.fields.length)ctx.addIssue({code:'custom',message:'Invalid field ownership or layout'});
+});
+export const bridgeRequestSchema=z.discriminatedUnion('action',[
+ prepare,
+ z.object({action:z.literal('send'),...binding,permittedUseConfirmed:z.literal(true)}).strict(),
+ z.object({action:z.literal('status'),...binding}).strict(),
+ z.object({action:z.literal('download'),...binding,artifact:z.enum(['signed','evidence'])}).strict(),
+ z.object({action:z.literal('remind'),...binding,operationId:z.uuid()}).strict(),
+]);
+export type BridgeCommand=z.infer<typeof bridgeRequestSchema>;
