+import {openTestDatabase} from '../db/test-database.ts';
+import {createDraftEnvelope} from '../envelopes.ts';
+import {withTransaction} from '../db/connection.ts';
+test('historical send intent never authorizes an ordinary sender transaction',async()=>{
+ const database=await openTestDatabase(),userId=randomUUID(),attempt=randomUUID();
+ try{
+  await database.query('insert into public."user"(id,name,email,role) values($1,$2,$3,$4)',[userId,'Synthetic',userId+'@example.invalid','user']);
+  const pdf=await PDFDocument.create();for(let i=0;i<9;i++)pdf.addPage([612,792]);
+  const draft=await createDraftEnvelope(userId,{title:'Synthetic locked agreement',sourcePdf:{body:await pdf.save(),contentType:'application/pdf',filename:'synthetic.pdf'}},{database,onCreatedInTransaction:async(envelope,tx)=>{
+   await tx.query('insert into cmg_bridge_envelopes(firm_id,claim_id,attempt_token,user_id,envelope_id,request_sha256,prepared,send_started) values($1,$2,$3,$4,$5,$6,true,true)',[randomUUID(),randomUUID(),attempt,userId,envelope.id,'a'.repeat(64)]);
+  }});
+  await assert.rejects(()=>database.query("update envelopes set status='sent' where id=$1",[draft.envelope.id]),/CMG send ownership/);
+  await withTransaction(async tx=>{
+   await tx.query("select set_config('cmg.bridge_attempt',$1,true)",[attempt]);
+   assert.equal((await tx.query("update envelopes set status='sent' where id=$1",[draft.envelope.id])).rowCount,1);
+  },database);
+  assert.equal((await database.query("select current_setting('cmg.bridge_attempt',true) as capability")).rows[0].capability??'','');
+ }finally{await database.query('delete from public."user" where id=$1',[userId]);await database.end();}
+});
