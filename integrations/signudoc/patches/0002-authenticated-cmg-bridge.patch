@@ -0,0 +1,29 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import {signBridgeRequest,verifyBridgeRequest} from './auth.ts';
+const identity={firmId:'11111111-1111-4111-8111-111111111111',key:'synthetic-bridge-fixture-only-01234567890123456789'};
+const now=1800000000000;
+const input={method:'POST',pathname:'/api/internal/cmg/v1',body:'{"action":"status"}'};
+const nonce='22222222-2222-4222-8222-222222222222';
+test('a correct signed request validates and returns the nonce for atomic replay protection',()=>{
+ const headers=signBridgeRequest(input,identity,now,nonce);
+ assert.equal(verifyBridgeRequest({...input,headers},identity,now),nonce);
+});
+test('body, method, path, key, firm, clock and nonce tampering are refused',()=>{
+ const headers=signBridgeRequest(input,identity,now,nonce);
+ for(const altered of [{...input,body:'{}'},{...input,method:'GET'},{...input,pathname:'/api/other'}])assert.equal(verifyBridgeRequest({...altered,headers},identity,now),null);
+ assert.equal(verifyBridgeRequest({...input,headers},{...identity,key:'wrong-secret-not-the-shared-key-12345'},now),null);
+ assert.equal(verifyBridgeRequest({...input,headers},{...identity,firmId:'33333333-3333-4333-8333-333333333333'},now),null);
+ assert.equal(verifyBridgeRequest({...input,headers},identity,now+301000),null);
+ assert.equal(verifyBridgeRequest({...input,headers},identity,now-31000),null);
+ const changed=new Headers(headers);changed.set('x-cmg-nonce','not-a-uuid');assert.equal(verifyBridgeRequest({...input,headers:changed},identity,now),null);
+});
+test('disabled/short keys and unsigned input never validate',()=>{
+ assert.equal(verifyBridgeRequest({...input,headers:new Headers()},identity,now),null);
+ assert.equal(verifyBridgeRequest({...input,headers:signBridgeRequest(input,identity,now,nonce)},{...identity,key:''},now),null);
+});
+
+test('whitespace-only keys cannot authenticate a bridge request',()=>{
+ const weak={...identity,key:' '.repeat(40)};
+ assert.throws(()=>signBridgeRequest(input,weak,now,nonce));
+});
diff --git a/src/lib/cmg-bridge/auth.ts b/src/lib/cmg-bridge/auth.ts
new file mode 100644
index 0000000..27657ce
--- /dev/null
+++ b/src/lib/cmg-bridge/auth.ts
@@ -0,0 +1,23 @@
+import {createHash,createHmac,randomUUID,timingSafeEqual} from 'node:crypto';
+
+export type BridgeIdentity = {firmId:string;key:string};
+export type BridgeRequest = {method:string;pathname:string;body:string;headers:Headers};
+const UUID=/^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$/i;
+function message(input:Omit<BridgeRequest,'headers'>,firm:string,time:string,nonce:string){
+ return ['cmg-signudoc-v1',firm,time,nonce,input.method.toUpperCase(),input.pathname,createHash('sha256').update(input.body).digest('hex')].join('\n');
+}
+export function signBridgeRequest(input:Omit<BridgeRequest,'headers'>,identity:BridgeIdentity,now=Date.now(),nonce=randomUUID()):Headers {
+ if(identity.key.trim().length<32||!UUID.test(identity.firmId)||!UUID.test(nonce))throw Error('Invalid bridge configuration');
+ const time=String(Math.floor(now/1000));
+ const signature=createHmac('sha256',identity.key).update(message(input,identity.firmId,time,nonce)).digest('hex');
+ return new Headers({'content-type':'application/json','x-cmg-firm':identity.firmId,'x-cmg-time':time,'x-cmg-nonce':nonce,'x-cmg-signature':signature});
+}
+/** Authentication only. Caller must atomically consume the returned nonce. */
+export function verifyBridgeRequest(input:BridgeRequest,identity:BridgeIdentity,now=Date.now()):string|null {
+ const firm=input.headers.get('x-cmg-firm'),time=input.headers.get('x-cmg-time'),nonce=input.headers.get('x-cmg-nonce'),signature=input.headers.get('x-cmg-signature');
+ if(identity.key.trim().length<32||firm!==identity.firmId||!UUID.test(identity.firmId)||!time||!/^\d{10}$/.test(time)||!nonce||!UUID.test(nonce)||!signature||!/^[a-f0-9]{64}$/.test(signature))return null;
+ const age=now-Number(time)*1000;
+ if(age>300000||age < -30000)return null;
+ const expected=createHmac('sha256',identity.key).update(message(input,firm,time,nonce)).digest();
+ return timingSafeEqual(expected,Buffer.from(signature,'hex'))?nonce:null;
+}
diff --git a/src/lib/cmg-bridge/handler.ts b/src/lib/cmg-bridge/handler.ts
new file mode 100644
index 0000000..41fee01
--- /dev/null
+++ b/src/lib/cmg-bridge/handler.ts
@@ -0,0 +1,136 @@
+import {createHash} from 'node:crypto';
+import {getDb,type DbPool} from '../db/connection.ts';
+import {createDraftEnvelope,replaceDraftEnvelopeFields,replaceDraftEnvelopeSigners,sendDraftEnvelope,EnvelopeMutationError} from '../envelopes.ts';
+import {sendManualEnvelopeNudge,ReminderMutationError} from '../reminders.ts';
+import {createStorageService} from '../services/storage.ts';
+import {applyRateLimit} from '../security/route-controls.ts';
+import {signBridgeRequest,verifyBridgeRequest,type BridgeIdentity} from './auth.ts';
+import {acquireBridgeAdmission} from './admission.ts';
+import {bridgeRequestSchema,type BridgeCommand} from './request.ts';
+
+export {signBridgeRequest};
+export type BridgeConfig=BridgeIdentity & {senderEmail:string};
+const PATH='/api/internal/cmg/v1';
+const MAX_BODY=3500000;
+class BridgeError extends Error{constructor(readonly status:number){super('Signing request unavailable');}}
+const fail=(status:number)=>new Response(JSON.stringify({error:'Signing request unavailable'}),{status,headers:{'content-type':'application/json','cache-control':'private, no-store'}});
+export function readBridgeConfig():BridgeConfig|null{
+ if(process.env.CMG_BRIDGE_ENABLED!=='1')return null;
+ const firmId=process.env.CMG_BRIDGE_FIRM_ID?.trim()??'',key=process.env.CMG_BRIDGE_KEY??'',senderEmail=process.env.CMG_BRIDGE_SENDER_EMAIL?.trim()??'';
+ if(!/^[a-f0-9-]{36}$/i.test(firmId)||key.trim().length<32||!senderEmail.includes('@'))return null;
+ return {firmId,key,senderEmail};
+}
+async function readBounded(request:Request){
+ const reader=request.body?.getReader();if(!reader)throw new BridgeError(400);
+ const parts:Uint8Array[]=[];let length=0;
+ try{for(;;){const item=await reader.read();if(item.done)break;length+=item.value.length;if(length>MAX_BODY){await reader.cancel();throw new BridgeError(413);}parts.push(item.value);}}
+ finally{reader.releaseLock();}
+ return Buffer.concat(parts).toString('utf8');
+}
+type Link={firm_id:string;claim_id:string;attempt_token:string;user_id:string;envelope_id:string;request_sha256:string;send_started:boolean;send_confirmed:boolean;prepared:boolean};
+async function lookup(database:DbPool,config:BridgeConfig,command:BridgeCommand,userId:string):Promise<Link>{
+ const result=await database.query<Link>('select * from cmg_bridge_envelopes where firm_id=$1 and claim_id=$2 and attempt_token=$3 and user_id=$4',[config.firmId,command.claimId,command.attemptToken,userId]);
+ if(!result.rows[0])throw new BridgeError(404);return result.rows[0];
+}
+async function status(database:DbPool,link:Link){
+ const result=await database.query('select id,status,expires_at,source_pdf_hash,signed_pdf_sha256,evidence_sha256,signed_pdf_key,evidence_key from envelopes where id=$1 and user_id=$2',[link.envelope_id,link.user_id]);
+ const envelope=result.rows[0];if(!envelope)throw new BridgeError(404);
+ const signers=await database.query('select name,email,status,signed_at from signers where envelope_id=$1 order by sign_order,id',[link.envelope_id]);
+ return {version:1,firmId:link.firm_id,claimId:link.claim_id,attemptToken:link.attempt_token,envelopeId:envelope.id,status:envelope.status==='sent'&&envelope.expires_at&&envelope.expires_at<Math.floor(Date.now()/1000)?'expired':envelope.status,sourceSha256:envelope.source_pdf_hash,deliveryConfirmed:link.send_confirmed,sendStarted:link.send_started,signers:signers.rows.map((s,i)=>({role:i===0?'Homeowner1':'Homeowner2',name:s.name,email:s.email,status:s.status,signedAt:s.signed_at})),artifacts:{signedSha256:envelope.signed_pdf_sha256,evidenceSha256:envelope.evidence_sha256}};
+}
+/** Only this handler exposes service operations. No session cookie grants access. */
+export async function handleCmgBridgeRequest(request:Request,options:{database?:DbPool;config?:BridgeConfig|null}={}):Promise<Response>{
+ const config=options.config===undefined?readBridgeConfig():options.config;
+ if(!config)return fail(404);
+ if(request.method!=='POST'||new URL(request.url).pathname!==PATH||new URL(request.url).search)return fail(404);
+ if(Number(request.headers.get('content-length')??0)>MAX_BODY)return fail(413);
+ try{
+  const body=await readBounded(request);
+  const nonce=verifyBridgeRequest({method:request.method,pathname:PATH,body,headers:request.headers},config);
+  if(!nonce)return fail(401);
+  const database=options.database??getDb();
+  const consumed=await database.query('insert into cmg_bridge_nonces(firm_id,nonce) values($1,$2) on conflict do nothing returning nonce',[config.firmId,nonce]);
+  if(consumed.rowCount!==1)return fail(409);
+  await database.query("delete from cmg_bridge_nonces where created_at < now()-interval '1 hour'");
+  const user=await database.query<{id:string;name:string;email:string}>('select id,name,email from public."user" where lower(email)=lower($1) and "emailVerified"=true',[config.senderEmail]);
+  const sender=user.rows[0];if(!sender)return fail(503);
+  const limited=await applyRateLimit({category:'cmg_bridge',key:'cmg-bridge:'+config.firmId,limit:120,windowMs:60000,request,userId:sender.id});
+  if(limited)return limited;
+  const parsed=bridgeRequestSchema.safeParse(JSON.parse(body));if(!parsed.success)return fail(400);
+  const command=parsed.data;
+  // Bounded per-install admission leaves connections available for the
+  // accepted operation's own transactions; contenders never block the pool.
+  const admission=await acquireBridgeAdmission(database,config.firmId);
+  if(!admission)return fail(429);
+  try{
+   if(command.action==='prepare'){
+    const bytes=Buffer.from(command.pdfBase64,'base64');
+    if(bytes.length>2400000||bytes.subarray(0,5).toString()!=='%PDF-'||createHash('sha256').update(bytes).digest('hex')!==command.sourceSha256)throw new BridgeError(400);
+    const digest=createHash('sha256').update(body).digest('hex');
+    const existing=await database.query<Link>('select * from cmg_bridge_envelopes where firm_id=$1 and attempt_token=$2',[config.firmId,command.attemptToken]);
+    let link=existing.rows[0];
+    if(link&&(link.claim_id!==command.claimId||link.user_id!==sender.id||link.request_sha256!==digest))throw new BridgeError(409);
+    if(!link){
+     await createDraftEnvelope(sender.id,{title:command.title,sourcePdf:{body:bytes,contentType:'application/pdf',filename:'cmg-lor.pdf'}},{database,onCreatedInTransaction:async(envelope,tx)=>{
+      if(envelope.pageCount!==9)throw new BridgeError(400);
+      await tx.query('insert into cmg_bridge_envelopes(firm_id,claim_id,attempt_token,user_id,envelope_id,request_sha256) values($1,$2,$3,$4,$5,$6)',[config.firmId,command.claimId,command.attemptToken,sender.id,envelope.id,digest]);
+     }});
+     link=await lookup(database,config,command,sender.id);
+    }
+    if(!link.prepared){
+     const parties=await replaceDraftEnvelopeSigners(sender.id,link.envelope_id,{signers:command.signers.map((s,i)=>({name:s.name,email:s.email,signOrder:i+1}))},database);
+     const roleIds=new Map(command.signers.map((s,i)=>[s.role,parties.signers[i]!.id]));
+     const saved=await replaceDraftEnvelopeFields(sender.id,link.envelope_id,{fields:command.fields.map(({role,...field})=>({...field,signerId:roleIds.get(role)!}))},database);
+     const freeze=await database.connect();
+     try{
+      await freeze.query('begin');
+      await freeze.query("select id from envelopes where id=$1 and user_id=$2 and status='draft' for no key update",[link.envelope_id,sender.id]);
+      const currentSigners=await freeze.query('select id,name,email,sign_order,role from signers where envelope_id=$1 order by sign_order,id',[link.envelope_id]);
+      const expectedSigners=parties.signers.map((p,i)=>({id:p.id,name:p.name,email:p.email,sign_order:i+1,role:'signer'}));
+      const currentFields=await freeze.query('select id,signer_id,type,page,x,y,width,height,required,label from fields where envelope_id=$1 order by id',[link.envelope_id]);
+      const expectedFields=saved.fields.map(f=>({id:f.id,signer_id:f.signerId,type:f.type,page:f.page,x:f.x,y:f.y,width:f.width,height:f.height,required:f.required,label:f.label??null})).sort((a,b)=>a.id.localeCompare(b.id));
+      if(JSON.stringify(currentSigners.rows)!==JSON.stringify(expectedSigners)||JSON.stringify(currentFields.rows)!==JSON.stringify(expectedFields))throw new BridgeError(409);
+      await freeze.query('update cmg_bridge_envelopes set prepared=true where firm_id=$1 and attempt_token=$2',[config.firmId,command.attemptToken]);
+      await freeze.query('commit');link.prepared=true;
+     }catch(error){await freeze.query('rollback');throw error;}finally{freeze.release();}
+    }
+    return Response.json(await status(database,link),{headers:{'cache-control':'private, no-store'}});
+   }
+   let link=await lookup(database,config,command,sender.id);
+   if(command.action==='send'){
+    if(!link.prepared)throw new BridgeError(409);
+    if(!link.send_confirmed){
+     if(link.send_started)throw new BridgeError(409); // Never automatically resend an uncertain delivery.
+     await database.query('update cmg_bridge_envelopes set send_started=true where firm_id=$1 and attempt_token=$2',[config.firmId,command.attemptToken]);
+     await sendDraftEnvelope(sender.id,link.envelope_id,{senderEmail:sender.email,senderName:sender.name,expiresInDays:7,reminderIntervalDays:null},{database,cmgBridgeAttemptToken:command.attemptToken});
+     await database.query('update cmg_bridge_envelopes set send_confirmed=true where firm_id=$1 and attempt_token=$2',[config.firmId,command.attemptToken]);
+     link=await lookup(database,config,command,sender.id);
+    }
+   }else if(command.action==='remind'){
+    if(!link.send_confirmed)throw new BridgeError(409);
+    const operation=await database.query('insert into cmg_bridge_reminders(firm_id,operation_id,attempt_token) values($1,$2,$3) on conflict do nothing returning operation_id',[config.firmId,command.operationId,command.attemptToken]);
+    if(operation.rowCount!==1)throw new BridgeError(409);
+    await sendManualEnvelopeNudge(sender.id,link.envelope_id,{senderEmail:sender.email,senderName:sender.name},{database});
+    await database.query('update cmg_bridge_reminders set confirmed=true where firm_id=$1 and operation_id=$2',[config.firmId,command.operationId]);
+   }else if(command.action==='download'){
+    const row=await database.query('select status,signed_pdf_key,evidence_key,signed_pdf_sha256,evidence_sha256 from envelopes where id=$1 and user_id=$2',[link.envelope_id,sender.id]);
+    const envelope=row.rows[0];if(envelope?.status!=='completed')throw new BridgeError(409);
+    const key=command.artifact==='signed'?envelope.signed_pdf_key:envelope.evidence_key;
+    const expected=command.artifact==='signed'?envelope.signed_pdf_sha256:envelope.evidence_sha256;
+    if(!key||!expected)throw new BridgeError(409);
+    const object=await createStorageService().getObject(key);
+    if(createHash('sha256').update(object.body).digest('hex')!==expected)throw new BridgeError(500);
+    return new Response(object.body.slice().buffer as ArrayBuffer,{headers:{'content-type':'application/pdf','cache-control':'private, no-store','x-content-type-options':'nosniff','x-cmg-sha256':expected}});
+   }
+   return Response.json(await status(database,link),{headers:{'cache-control':'private, no-store'}});
+  }finally{
+   await admission.release();
+  }
+ }catch(error){
+  if(error instanceof BridgeError)return fail(error.status);
+  if(error instanceof SyntaxError)return fail(400);
+  if(error instanceof EnvelopeMutationError||error instanceof ReminderMutationError)return fail(error.statusCode);
+  console.error('[cmg-bridge] request failed');
+  return fail(500);
+ }
+}
