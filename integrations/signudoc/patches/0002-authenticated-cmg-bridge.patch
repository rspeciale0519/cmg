+import assert from 'node:assert/strict';
+import {test} from 'node:test';
+import {openTestDatabase} from '../db/test-database.ts';
+import {acquireBridgeAdmission} from './admission.ts';
+test('bursts above pool capacity fail fast without starving accepted bridge work',async()=>{
+ const database=await openTestDatabase();
+ try{
+  const held=await acquireBridgeAdmission(database,'synthetic-capacity-check');
+  assert.ok(held);
+  const results=await Promise.all(Array.from({length:24},()=>acquireBridgeAdmission(database,'synthetic-capacity-check')));
+  assert.ok(results.every(r=>r===null));
+  assert.equal((await database.query('select 1 as ready')).rows[0].ready,1);
+  await held.release();
+  const next=await acquireBridgeAdmission(database,'synthetic-capacity-check');assert.ok(next);await next.release();
+ }finally{await database.end();}
+});
