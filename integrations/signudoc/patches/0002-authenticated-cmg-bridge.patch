+-- Private per-install integration state; never exposed through sender routes.
+create table cmg_bridge_nonces (
+  firm_id uuid not null,
+  nonce uuid not null,
+  created_at timestamptz not null default now(),
+  primary key (firm_id, nonce)
+);
+create index cmg_bridge_nonces_created_idx on cmg_bridge_nonces(created_at);
+create table cmg_bridge_envelopes (
+  firm_id uuid not null,
+  claim_id uuid not null,
+  attempt_token uuid not null,
+  user_id text not null references public."user"(id) on delete cascade,
+  envelope_id text not null unique references envelopes(id) on delete cascade,
+  request_sha256 text not null check(length(request_sha256)=64),
+  send_started boolean not null default false,
+  send_confirmed boolean not null default false,
+  prepared boolean not null default false,
+  created_at timestamptz not null default now(),
+  primary key (firm_id, attempt_token)
+);
+create table cmg_bridge_reminders (
+  firm_id uuid not null,
+  operation_id uuid not null,
+  attempt_token uuid not null,
+  confirmed boolean not null default false,
+  created_at timestamptz not null default now(),
+  primary key (firm_id, operation_id),
+  foreign key (firm_id, attempt_token) references cmg_bridge_envelopes(firm_id,attempt_token) on delete cascade
+);
+alter table cmg_bridge_nonces enable row level security;
+alter table cmg_bridge_envelopes enable row level security;
+alter table cmg_bridge_reminders enable row level security;
+revoke all on cmg_bridge_nonces,cmg_bridge_envelopes,cmg_bridge_reminders from public;
diff --git a/db/migrations/20261117010100_cmg_bridge_review_lock.sql b/db/migrations/20261117010100_cmg_bridge_review_lock.sql
