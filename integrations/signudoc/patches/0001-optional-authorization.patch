diff --git a/src/lib/schemas/optional-fields.test.ts b/src/lib/schemas/optional-fields.test.ts
new file mode 100644
index 0000000..8e6fa51
--- /dev/null
+++ b/src/lib/schemas/optional-fields.test.ts
@@ -0,0 +1,17 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import {fieldPlacementSchema,signingFieldSubmissionSchema} from './field.ts';
+
+const placement={signerId:'synthetic-signer',page:1,x:.1,y:.1,width:.1,height:.03};
+for(const type of ['signature','initials','date'] as const){
+ test(`${type} may be genuinely optional without changing required-by-default behavior`,()=>{
+  const optional=fieldPlacementSchema.parse({...placement,type,required:false});
+  assert.equal(optional.required,false);
+  assert.equal(fieldPlacementSchema.parse({...placement,type}).required,true);
+ });
+}
+test('optional dates require an explicit boolean choice; no arbitrary client-provided date',()=>{
+ assert.equal(signingFieldSubmissionSchema.parse({fieldId:'date-choice',type:'date',checked:true}).type,'date');
+ assert.equal(signingFieldSubmissionSchema.parse({fieldId:'date-choice',type:'date',checked:false}).type,'date');
+ assert.equal(signingFieldSubmissionSchema.safeParse({fieldId:'date-choice',type:'date',value:'01/01/1900'}).success,false);
+});
