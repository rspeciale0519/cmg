diff --git a/src/lib/cmg-bridge/forge-security.test.ts b/src/lib/cmg-bridge/forge-security.test.ts
new file mode 100644
index 0000000..51b86f0
--- /dev/null
+++ b/src/lib/cmg-bridge/forge-security.test.ts
@@ -0,0 +1,19 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import forge from 'node-forge';
+// Regression for GHSA-6889-vf6x-f3g5, synthetic bytes only. Identity/small-order
+// keys must never authenticate a message without a matching private key.
+test('Ed25519 rejects a forged signature under the identity public key',()=>{
+ const publicKey=Buffer.alloc(32);publicKey[0]=1;
+ const signature=Buffer.alloc(64);signature[0]=1;
+ for(const message of ['CMG synthetic agreement','a different synthetic agreement']){
+  assert.equal(forge.pki.ed25519.verify({message:Buffer.from(message),signature,publicKey}),false);
+ }
+});
+test('Ed25519 accepts an authentic signature and refuses altered content',()=>{
+ const pair=forge.pki.ed25519.generateKeyPair({seed:Buffer.alloc(32,7)});
+ const message=Buffer.from('CMG synthetic cryptographic regression');
+ const signature=forge.pki.ed25519.sign({message,privateKey:pair.privateKey});
+ assert.equal(forge.pki.ed25519.verify({message,signature,publicKey:pair.publicKey}),true);
+ assert.equal(forge.pki.ed25519.verify({message:Buffer.from('altered agreement'),signature,publicKey:pair.publicKey}),false);
+});
