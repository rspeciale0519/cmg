-- CMG Property Solutions — the second factor, enforced in the database
--
-- WHAT THIS SUITE IS ABOUT
--
-- §7.2 requires MFA on every staff account. Until this round the whole rule was one
-- comparison in src/lib/supabase/proxy.ts:
--
--     if (SURFACES[surface].requiresAal2 && claims.aal !== "aal2") … redirect("/mfa")
--
-- and `grep -rn aal supabase/migrations/` returned nothing at all. That is a routing
-- decision inside Next.js, and PostgREST does not sit behind Next.js.
-- NEXT_PUBLIC_SUPABASE_URL and the publishable key are public by construction — they are
-- compiled into the browser bundle — so an attacker who has obtained nothing but a staff
-- *password* signs in against GoTrue directly, receives a perfectly valid aal1 token, and
-- speaks to /rest/v1 without the proxy ever seeing the request. Reproduced against this
-- build before the fix, with an aal1 token and the publishable key and nothing else:
--
--     GET   /rest/v1/profiles                        200  the whole staff directory
--     GET   /rest/v1/claims                          200
--     GET   /rest/v1/claim_financials                200  settlement amounts and notes
--     GET   /rest/v1/consents                        200  email, phone, consent text, IP
--     POST  /rest/v1/rpc/admin_user_directory        200  every account's email + MFA state
--     PATCH /rest/v1/profiles?id=eq.<adjuster>       200  {"role":"owner"} — escalation
--
-- The fix puts the factor test where the other identity rules already live, inside
-- private.current_app_role(), so that a staff role at aal1 resolves to NULL and every
-- helper, policy, guard and RPC built on it refuses without having to be told about MFA.
--
-- WHAT IS DELIBERATELY *NOT* ASSERTED HERE
--
-- The review asked for "an aal1 owner reads zero rows from profiles". This suite asserts
-- something narrower on that one table — zero rows *about anyone else*, exactly one row
-- about themselves — because zero is the wrong number and would break the product.
-- `profiles_select_self_or_staff` has a self branch, and both src/lib/authz.ts
-- `getSession()` and the proxy read the caller's own role through it to decide where to
-- send them. Close the self branch at aal1 and the proxy reads no role, treats the session
-- as signed out and redirects to /login instead of /mfa — so a staff member who has just
-- entered their password can never reach the page that enrols the second factor, and MFA
-- becomes unreachable rather than mandatory. The exposure the finding is actually about is
-- the *directory* — colleagues' names, phones, roles and activation — and that is what
-- goes to zero below. A caller reading their own name after presenting their own password
-- is not the defect.
--
--   owner       00000000-0000-4000-a000-000000000001  Austin Graham
--   adjuster    00000000-0000-4000-a000-000000000002  Dana Reyes
--   assistant   00000000-0000-4000-a000-000000000003  Priya Nolan
--   customer    00000000-0000-4000-a000-000000000004  Marcus Bell
--   partner     00000000-0000-4000-a000-000000000005  Tyler Boone

begin;
set local client_min_messages = warning;
create extension if not exists pgtap with schema extensions;

select plan(59);

-- ---------------------------------------------------------------------------
-- private.has_aal2() — shape, grants, and what it does with a missing claim
-- ---------------------------------------------------------------------------

select has_function(
  'private',
  'has_aal2',
  'the factor test is a named helper rather than an expression repeated in each policy, so there is one place to read it and one place to change it'
);

select is(
  has_function_privilege('anon', 'private.has_aal2()', 'execute'),
  false,
  'anon cannot execute it, matching every other routine in the private schema'
);

select set_config('request.jwt.claims', '', true);

select is(
  private.has_aal2(), false,
  'THE MISSING-CLAIM DECISION: no request.jwt.claims at all reads as aal1, not as aal2 — the predicate fails closed, so a GoTrue that renamed the field or a proxy that dropped it costs staff their access (an outage someone reports) rather than costing the workspace its MFA enforcement (a breach nobody sees)'
);

select set_config(
  'request.jwt.claims',
  '{"sub":"00000000-0000-4000-a000-000000000001","role":"authenticated"}',
  true
);

select is(
  private.has_aal2(), false,
  'a claims blob carrying a subject but no aal is aal1 too — this is the shape every pgTAP fixture in this repo used before this round, which is why they now say aal2 explicitly'
);

select set_config(
  'request.jwt.claims',
  '{"sub":"00000000-0000-4000-a000-000000000001","role":"authenticated","aal":"aal1"}',
  true
);

select is(
  private.has_aal2(), false,
  'and the token GoTrue actually issues after a password-only sign-in — the one the reviewer held — is refused'
);

select set_config(
  'request.jwt.claims',
  '{"sub":"00000000-0000-4000-a000-000000000001","role":"authenticated","aal":"aal2"}',
  true
);

select is(
  private.has_aal2(), true,
  'aal2 is the only value that passes'
);

-- ---------------------------------------------------------------------------
-- A staff role at aal1 is not a lesser role — it is no role
-- ---------------------------------------------------------------------------

select set_config(
  'request.jwt.claims',
  '{"sub":"00000000-0000-4000-a000-000000000001","role":"authenticated","aal":"aal1"}',
  true
);
set local role authenticated;

select is(
  private.current_app_role(), null::public.app_role,
  'an owner one factor short resolves to NULL, the same answer a deactivated account gets — §7.2 makes "staff" and "staff with a second factor" one category, so there is no reduced tier to fall back to'
);

select is(private.is_owner(), false, 'so is_owner() is false');
select is(private.is_staff(), false, 'and is_staff() is false');
select is(
  private.can_manage_claim('20000000-0000-4000-a000-000000000001'), false,
  'and the claim-scoped helper the money policies are written against is false'
);

select is(
  (select count(*)::int from public.claims), 0,
  'GET /rest/v1/claims — 200 with the caseload before, zero rows now'
);

select is(
  (select count(*)::int from public.claim_financials), 0,
  'GET /rest/v1/claim_financials — settlement amounts and fee notes, zero rows now'
);

select is(
  (select count(*)::int from public.consents), 0,
  'GET /rest/v1/consents — the signed consent evidence, with the subject email, phone and originating IP, zero rows now'
);

select is(
  (select count(*)::int from public.leads), 0,
  'and the intake queue, which is the same is_staff() read wearing a different name'
);

select is(
  (select count(*)::int from public.audit_log), 0,
  'and the audit trail, so an aal1 session cannot read what it failed to do either'
);

select is(
  (select count(*)::int from public.profiles where id <> '00000000-0000-4000-a000-000000000001'), 0,
  'GET /rest/v1/profiles — the staff directory is gone: zero rows about anyone else'
);

select is(
  (select count(*)::int from public.profiles), 1,
  'and exactly one row survives, the caller''s own, because getSession() and the proxy read the role through that self branch to decide the caller belongs on /mfa — see the note at the top of this file for why zero here would make MFA unreachable rather than mandatory'
);

select throws_ok(
  $$ select * from public.admin_user_directory() $$,
  '42501'::char(5), null::text,
  'POST /rest/v1/rpc/admin_user_directory — refused, and it is the worst of the six: it answered with every account''s sign-in address and MFA state, which is a list of exactly which colleague to attack next'
);

select throws_ok(
  $$ select public.change_staff_privileges(
       '00000000-0000-4000-a000-000000000002'::uuid, 'owner'::public.app_role, null) $$,
  '42501'::char(5), null::text,
  'and the RPC that hands out roles is refused with a sentence about the session rather than about the target'
);

-- The escalation itself. RLS declines the write, and PostgREST reports a zero-row PATCH as
-- a success, so the assertion has to be about the table rather than about the error.
select lives_ok(
  $$ update public.profiles set role = 'owner'
      where id = '00000000-0000-4000-a000-000000000002' $$,
  'PATCH /rest/v1/profiles?id=eq.<adjuster> {"role":"owner"} raises nothing — profiles_update_owner simply matches no rows, which is what a 200 with an empty body looked like'
);

-- The one row an aal1 caller *can* reach is their own, and profiles_update_self admits
-- them onto it on identity alone. That is the path the RLS gate cannot close, so
-- guard_profile_privileges() asks the question itself.
select throws_ok(
  $$ update public.profiles set is_active = false
      where id = '00000000-0000-4000-a000-000000000001' $$,
  '42501'::char(5), null::text,
  'and self-deactivation — the one privilege write that reaches the trigger through profiles_update_self rather than profiles_update_owner — is refused there, so an aal1 owner cannot strand the workspace with a password alone'
);

select throws_ok(
  $$ update public.profiles set role = 'adjuster'
      where id = '00000000-0000-4000-a000-000000000001' $$,
  '42501'::char(5), null::text,
  'as is self-demotion, for the same reason and at the same layer'
);

-- An ordinary edit to one's own row is untouched: the gate is on privilege columns.
select lives_ok(
  $$ update public.profiles set phone = '407-555-0101'
      where id = '00000000-0000-4000-a000-000000000001' $$,
  'while changing one''s own phone number still works at aal1 — guard_profile_privileges() returns early when role, partner_company_id and is_active are all untouched, so the gate did not become a general write lock'
);

select set_config('request.jwt.claims', '', true);
reset role;

select is(
  (select role::text from public.profiles where id = '00000000-0000-4000-a000-000000000002'),
  'adjuster',
  'and checked from outside the session: the adjuster is still an adjuster, so the escalation that returned 200 before now changes nothing'
);

select is(
  (select is_active from public.profiles where id = '00000000-0000-4000-a000-000000000001'),
  true,
  'and the owner is still active'
);

-- ---------------------------------------------------------------------------
-- The adjuster and the assistant, same gate
-- ---------------------------------------------------------------------------

select set_config(
  'request.jwt.claims',
  '{"sub":"00000000-0000-4000-a000-000000000002","role":"authenticated","aal":"aal1"}',
  true
);
set local role authenticated;

select is(private.current_app_role(), null::public.app_role, 'an aal1 adjuster resolves to NULL as well');
select is(
  (select count(*)::int from public.claims), 0,
  'and reads none of the claims assigned to them'
);
select is(
  (select count(*)::int from public.profiles where id <> '00000000-0000-4000-a000-000000000002'), 0,
  'and none of the directory'
);
select throws_ok(
  $$ select * from public.admin_user_directory() $$,
  '42501'::char(5), null::text,
  'and is refused the directory RPC — which would have refused them at aal2 too, but for the other reason'
);

select set_config('request.jwt.claims', '', true);
reset role;

select set_config(
  'request.jwt.claims',
  '{"sub":"00000000-0000-4000-a000-000000000003","role":"authenticated","aal":"aal1"}',
  true
);
set local role authenticated;

select is(private.current_app_role(), null::public.app_role, 'an aal1 assistant resolves to NULL as well');
select is(
  (select count(*)::int from public.claims), 0,
  'and the assistant''s caseload-wide read — the broadest of the three — is closed with it'
);
select is(
  (select count(*)::int from public.leads), 0,
  'as is the intake queue the assistant owns'
);

select set_config('request.jwt.claims', '', true);
reset role;

-- ---------------------------------------------------------------------------
-- The same accounts at aal2 — the gate must be a gate, not a wall
-- ---------------------------------------------------------------------------

select set_config(
  'request.jwt.claims',
  '{"sub":"00000000-0000-4000-a000-000000000001","role":"authenticated","aal":"aal2"}',
  true
);
set local role authenticated;

select is(private.current_app_role(), 'owner'::public.app_role, 'the same owner at aal2 is an owner again');
select is(private.is_owner(), true, 'and is_owner() is true');

select cmp_ok(
  (select count(*)::int from public.claims), '>', 0,
  'and reads claims'
);
select cmp_ok(
  (select count(*)::int from public.claim_financials), '>', 0,
  'and the money'
);
select cmp_ok(
  (select count(*)::int from public.consents), '>', 0,
  'and the consent evidence'
);
select cmp_ok(
  (select count(*)::int from public.profiles), '>', 1,
  'and the staff directory'
);
select cmp_ok(
  (select count(*)::int from public.admin_user_directory()), '>', 0,
  'and the account directory RPC answers'
);

select lives_ok(
  $$ select public.change_staff_privileges(
       '00000000-0000-4000-a000-000000000002'::uuid, 'assistant'::public.app_role, null) $$,
  'and the privilege RPC that was refused a moment ago now succeeds — every refusal above was about the factor and nothing else'
);

select is(
  (select role::text from public.profiles where id = '00000000-0000-4000-a000-000000000002'),
  'assistant',
  'and the change actually landed'
);

select lives_ok(
  $$ select public.change_staff_privileges(
       '00000000-0000-4000-a000-000000000002'::uuid, 'adjuster'::public.app_role, null) $$,
  'put back'
);

select set_config('request.jwt.claims', '', true);
reset role;

select set_config(
  'request.jwt.claims',
  '{"sub":"00000000-0000-4000-a000-000000000002","role":"authenticated","aal":"aal2"}',
  true
);
set local role authenticated;

select is(private.current_app_role(), 'adjuster'::public.app_role, 'the adjuster at aal2 is an adjuster again');
select cmp_ok(
  (select count(*)::int from public.claims), '>', 0,
  'and sees the claims assigned to them'
);

select set_config('request.jwt.claims', '', true);
reset role;

-- ---------------------------------------------------------------------------
-- Customers and partners authenticate with a password and nothing else
-- ---------------------------------------------------------------------------
--
-- §7.2 asks for a second factor from staff. A homeowner and a partner rep have none to
-- present, so their sessions are aal1 for the life of the account. If the gate had been
-- written as "aal2 or nothing" rather than scoped to the three staff roles, every
-- homeowner would have been locked out of their own portal by a security fix — which is
-- the failure mode this section exists to catch, in the exact shape GoTrue produces.

select set_config(
  'request.jwt.claims',
  '{"sub":"00000000-0000-4000-a000-000000000004","role":"authenticated","aal":"aal1"}',
  true
);
set local role authenticated;

select is(
  private.current_app_role(), 'customer'::public.app_role,
  'a customer at aal1 is a customer — the gate is scoped to owner/adjuster/assistant, not applied to everyone with a session'
);

select cmp_ok(
  (select count(*)::int from public.claims), '>', 0,
  'and still reads the claim they are a claimant on'
);

select cmp_ok(
  (select count(*)::int from public.documents), '>', 0,
  'and its documents'
);

select is(
  (select count(*)::int from public.claim_financials), 0,
  'and still cannot see the money, which was never theirs to see — the gate did not disturb the matrix underneath it'
);

select set_config('request.jwt.claims', '', true);
reset role;

select set_config(
  'request.jwt.claims',
  '{"sub":"00000000-0000-4000-a000-000000000005","role":"authenticated","aal":"aal1"}',
  true
);
set local role authenticated;

select is(
  private.current_app_role(), 'partner'::public.app_role,
  'a partner rep at aal1 is a partner rep'
);

select cmp_ok(
  (select count(*)::int from public.claim_partner_summaries), '>', 0,
  'and still reads their referral projection'
);

select set_config('request.jwt.claims', '', true);
reset role;

-- ---------------------------------------------------------------------------
-- The service role has no second factor to present
-- ---------------------------------------------------------------------------

select is(
  private.is_service_context(), true,
  'a bare connection is a service context, which is how the seed, the migrations and every suite in this directory run'
);

select set_config(
  'request.jwt.claims',
  '{"sub":"00000000-0000-4000-a000-000000000003","role":"service_role"}',
  true
);

select is(
  private.current_app_role(), 'assistant'::public.app_role,
  'and a service-role JWT keeps its staff role with no aal claim at all: PostgREST has already handed that token a BYPASSRLS database role before any of this runs, and a server-side key is not a person with an authenticator app — gating it would break the §6 intake re-parent and the invite flow for a rule that cannot apply to them'
);

select set_config('request.jwt.claims', '', true);
reset role;

-- Establish the one-owner premise independently of mutable shared data.
update public.profiles
   set is_active = false
 where role = 'owner'
   and is_active
   and id <> '00000000-0000-4000-a000-000000000001';

-- ---------------------------------------------------------------------------
-- The floor is serialised — pg_advisory_xact_lock() on the trigger path
-- ---------------------------------------------------------------------------
--
-- BACKEND MAJOR 1. public.guard_profile_privileges() checked "would this leave zero active
-- owners?" with a bare `not exists` and no lock. In READ COMMITTED two transactions
-- demoting two *different* owners each take a snapshot predating the other's write, each
-- see the other still active, and both commit. Reproduced over real HTTP on the first
-- attempt: two parallel PATCHes returned 204/204 and left zero active owners with no audit
-- row — and from zero the workspace cannot be repaired from inside the product, because
-- this same trigger requires an active owner before it will change any privilege.
--
-- public.change_staff_privileges() already held `select … for update`, but the REST path
-- never calls it, and that lock could not simply be moved into the trigger: the trigger is
-- already inside an UPDATE of one candidate row, so row-locking the other candidates makes
-- two concurrent callers each hold what the other wants. An advisory lock is attached to no
-- row and has no such interaction.
--
-- A single pgTAP session cannot stage the interleaving, so what is pinned here is the
-- property the fix rests on: the lock is taken, it is taken on the trigger path rather than
-- only in the RPC, and it is taken only by an update that can actually lower the count. The
-- interleaving itself is demonstrated with two psql sessions and recorded in the round
-- report.

select is(
  (select count(*)::int from pg_locks
    where locktype = 'advisory' and pid = pg_backend_pid()),
  0,
  'no advisory lock is held yet, so the two assertions below are about this transaction and not about a leftover'
);

select set_config(
  'request.jwt.claims',
  '{"sub":"00000000-0000-4000-a000-000000000001","role":"authenticated","aal":"aal2"}',
  true
);
set local role authenticated;

select lives_ok(
  $$ update public.profiles set role = 'assistant'
      where id = '00000000-0000-4000-a000-000000000002' $$,
  'demoting an adjuster is a privilege change that cannot lower the owner count'
);

select is(
  (select count(*)::int from pg_locks
    where locktype = 'advisory' and pid = pg_backend_pid()),
  0,
  'and it takes no advisory lock — the guard is scoped to updates that stop a row being an active owner, so ordinary staff edits do not queue behind each other'
);

select set_config('request.jwt.claims', '', true);
reset role;

-- A second active owner, so the demotion below is allowed to succeed and the lock can be
-- observed on the success path rather than only on the raise.
update public.profiles set role = 'owner', is_active = true
 where id = '00000000-0000-4000-a000-000000000003';

select set_config(
  'request.jwt.claims',
  '{"sub":"00000000-0000-4000-a000-000000000001","role":"authenticated","aal":"aal2"}',
  true
);
set local role authenticated;

select lives_ok(
  $$ update public.profiles set is_active = false
      where id = '00000000-0000-4000-a000-000000000003' $$,
  'with two active owners, demoting one is permitted'
);

select is(
  (select count(*)::int from pg_locks
    where locktype = 'advisory' and pid = pg_backend_pid()),
  1,
  'and this time the trigger took pg_advisory_xact_lock() before reading the roster — the serialisation point the concurrent PATCH pair went through unguarded, now on the path every writer uses rather than only on the RPC nobody is obliged to call'
);

select is(
  (select count(*)::int from public.profiles where role = 'owner' and is_active),
  1,
  'one active owner remains, which is the floor holding on the ordinary path'
);

select throws_ok(
  $$ update public.profiles set is_active = false
      where id = '00000000-0000-4000-a000-000000000001' $$,
  'CMG01'::char(5), null::text,
  'and taking the last one is still refused, with the floor''s own SQLSTATE rather than the authority one'
);

select set_config('request.jwt.claims', '', true);
reset role;

select * from finish();
rollback;
