# Local setup uses Node.js 22, npm ci, and npm run db:start.
# Supabase uses host ports 15420 through 15429. See README.md.
# Keep secrets out of source control and client code.
# Vercel environment changes require a new deployment.
# Current hosted state and launch gates are recorded in docs/temp/HANDOFF.md.

# Supabase
# Copy local values from the local stack. Do not use hosted production keys locally.
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:15421"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# SERVER-ONLY. Used by authorized system flows, including public ingestion,
# invites, outbox, document storage, cleanup, and PandaDoc webhooks.
SUPABASE_SECRET_KEY=""

# Site
# Absolute origin for metadata and links. Use the verified HTTPS origin in production.
# Owner-generated vendor intake links also use this origin. No vendor-specific variable is needed.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# simple: public site, claim intake, contact forms, public emails, and cleanup.
# platform: private staff, customer, and partner features.
# Missing or invalid values select simple. Platform activation needs separate approval.
SITE_MODE="simple"

# Email
# SERVER-ONLY. Without this key, messages remain queued and cannot be delivered.
RESEND_API_KEY=""
# Use an address on the verified Resend sending domain.
EMAIL_FROM="CMG Property Solutions <claims@cmgpropertysolutions.net>"
# Verify the owner-approved recipient before sending production alerts.
EMAIL_STAFF_INBOX="Austin@CMGPropertySolutions.net"

# Turnstile
# Official always-pass test keys. Use these only in local or approved test environments.
# Replace both keys with verified live values for the production hostname.
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# PandaDoc: deferred while SITE_MODE=simple
# SERVER-ONLY. An absent API key selects the manual provider in platform mode.
# The current flow uploads bundled PDFs with PandaDoc roles H1 and H2.
# PANDADOC_LOR_TEMPLATE_UUID and PANDADOC_LOR_TEMPLATE_UUID_SINGLE are legacy,
# optional settings. The bundled-PDF flow does not require or use them.
PANDADOC_API_KEY=""
PANDADOC_WEBHOOK_SHARED_KEY=""
# Optional transport overrides. Keep the default API URL unless a test requires another.
# PANDADOC_API_BASE_URL="https://api.pandadoc.com/public/v1"
# PANDADOC_POLL_INTERVAL_MS="2000"
# PANDADOC_POLL_MAX_ATTEMPTS="20"

# Approved live draft test only
# Set PANDADOC_LIVE_DRAFT_TEST=1 in the invoking shell, never in this file or CI.
# Also supply PANDADOC_API_KEY and PANDADOC_DRAFT_TEST_EMAIL.
# Credentials can come from the shell or this optional local environment file.
# The test creates a real PandaDoc draft. It does not send it.
# Keep the opt-in absent during normal test discovery and release checks.
# PANDADOC_DRAFT_TEST_EMAIL=""

# Cron
# SERVER-ONLY. Vercel sends Authorization: Bearer <CRON_SECRET>.
# Missing configuration makes protected cron routes return 503.
# vercel.json schedules /api/cron/outbox daily at 14:00 UTC.
# It schedules /api/cron/storage-cleanup daily at 14:17 UTC.
# Daily execution can delay retries and cleanup by days under backlog.
# Hobby execution can vary within the scheduled hour.
CRON_SECRET=""
