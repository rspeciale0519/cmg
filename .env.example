# ─── Supabase ────────────────────────────────────────────────────────────────
# Local dev: run `npm run db:start` and copy the printed API URL + keys.
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# SERVER-ONLY. Never expose. Used exclusively by server-only modules:
# public intake/lead ingestion, invite issuance, outbox, PandaDoc webhooks.
SUPABASE_SECRET_KEY=""

# ─── Site ────────────────────────────────────────────────────────────────────
# Absolute origin, used for invite links, email links and metadata.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── Email (Resend) ──────────────────────────────────────────────────────────
# SERVER-ONLY. Without it the outbox queues but cannot deliver.
RESEND_API_KEY=""
# Verified sending domain address; must match the domain verified in Resend.
EMAIL_FROM="CMG Property Solutions <claims@cmgpropertysolutions.net>"
# Where public intake + contact notifications are delivered internally.
EMAIL_STAFF_INBOX="Austin@CMGPropertySolutions.net"

# ─── Cloudflare Turnstile (public form bot defense) ──────────────────────────
# These are Cloudflare's official ALWAYS-PASSES test keys — safe for dev only.
# Replace with real keys before launch.
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# ─── PandaDoc e-signature ────────────────────────────────────────────────────
# SERVER-ONLY. Absent => ManualSignProvider fallback (staff sends + uploads the
# signed copy by hand). See docs/reference/pandadoc/06-cmg-integration-blueprint.md
PANDADOC_API_KEY=""
# Template built in the PandaDoc editor; roles Homeowner1 / Homeowner2.
PANDADOC_LOR_TEMPLATE_UUID=""
# Optional single-signer variant, used when a claim has one claimant.
PANDADOC_LOR_TEMPLATE_UUID_SINGLE=""
# HMAC-SHA256 shared key used to verify inbound webhook signatures.
PANDADOC_WEBHOOK_SHARED_KEY=""

# ─── Cron ────────────────────────────────────────────────────────────────────
# Bearer secret guarding /api/cron/* routes.
CRON_SECRET=""
